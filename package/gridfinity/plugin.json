{
  "id": "gridfinity",
  "name": "Gridfinity",
  "version": "0.4.0",
  "description": "Gridfinity bins (hollow or solid for custom cutouts) and baseplates, full, half or custom grid, with feet, stacking lip, holes and dividers.",
  "capabilities": [
    "commands@0.1"
  ],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {
        "name": "bin",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "required": [
            "grid",
            "width",
            "depth",
            "height",
            "inside"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "title": "Width (cells)",
              "description": "Cells along X (42 mm, 21 mm on the half grid, or the custom size; at most 504 mm and 24 cells)",
              "minimum": 1,
              "maximum": 24,
              "default": 1
            },
            "depth": {
              "type": "integer",
              "title": "Depth (cells)",
              "description": "Cells along Y (42 mm, 21 mm on the half grid, or the custom size; at most 504 mm and 24 cells)",
              "minimum": 1,
              "maximum": 24,
              "default": 1
            },
            "height": {
              "type": "integer",
              "title": "Height (units)",
              "description": "Height units, 7 mm each",
              "minimum": 2,
              "maximum": 20,
              "default": 3
            },
            "dividers_x": {
              "type": "integer",
              "title": "Dividers across X",
              "description": "Walls splitting the bin along X (hollow bins)",
              "minimum": 0,
              "maximum": 10,
              "default": 0
            },
            "dividers_y": {
              "type": "integer",
              "title": "Dividers across Y",
              "description": "Walls splitting the bin along Y (hollow bins)",
              "minimum": 0,
              "maximum": 10,
              "default": 0
            },
            "holes_magnet": {
              "type": "boolean",
              "title": "Magnet holes",
              "description": "6.5 x 2.4 mm holes in every foot",
              "default": false
            },
            "holes_screw": {
              "type": "boolean",
              "title": "Screw holes",
              "description": "3 mm holes in every foot",
              "default": false
            },
            "position_x": {
              "type": "number",
              "title": "Position X",
              "description": "Corner of the bin",
              "default": 0,
              "unit": "mm"
            },
            "position_y": {
              "type": "number",
              "title": "Position Y",
              "description": "Corner of the bin",
              "default": 0,
              "unit": "mm"
            },
            "stacking_lip": {
              "type": "boolean",
              "title": "Stacking lip",
              "description": "Lip on top so bins stack",
              "default": true
            },
            "title": {
              "type": "string",
              "title": "Body name",
              "description": "Leave empty for an automatic name",
              "maxLength": 60
            },
            "grid": {
              "type": "string",
              "title": "Grid size",
              "description": "Full: 42 mm feet. Half: 21 mm feet, four fit in one baseplate pocket. Custom: your own cell size, set below (fits only other parts with the same size)",
              "enum": [
                "42 mm (full)",
                "21 mm (half)",
                "Custom (sizes below)"
              ],
              "default": "42 mm (full)"
            },
            "inside": {
              "type": "string",
              "title": "Inside",
              "description": "Hollow bin, or filled to the top of the walls so you can cut your own shapes into it",
              "enum": [
                "Hollow",
                "Solid (for custom cutouts)"
              ],
              "default": "Hollow"
            },
            "custom_size_x": {
              "type": "number",
              "title": "Custom cell X",
              "description": "Cell size along X, only used when Grid size is Custom",
              "minimum": 15,
              "maximum": 100,
              "default": 42,
              "unit": "mm"
            },
            "custom_size_y": {
              "type": "number",
              "title": "Custom cell Y",
              "description": "Cell size along Y, only used when Grid size is Custom",
              "minimum": 15,
              "maximum": 100,
              "default": 42,
              "unit": "mm"
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Gridfinity bin"
          }
        ]
      },
      {
        "name": "baseplate",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "required": [
            "grid",
            "width",
            "depth",
            "bottom"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "title": "Width (cells)",
              "description": "Cells along X (42 mm, 21 mm on the half grid, or the custom size; at most 504 mm and 24 cells)",
              "minimum": 1,
              "maximum": 24,
              "default": 3
            },
            "depth": {
              "type": "integer",
              "title": "Depth (cells)",
              "description": "Cells along Y (42 mm, 21 mm on the half grid, or the custom size; at most 504 mm and 24 cells)",
              "minimum": 1,
              "maximum": 24,
              "default": 3
            },
            "holes_magnet": {
              "type": "boolean",
              "title": "Magnet holes",
              "description": "6.5 x 2.4 mm holes in every pocket (needs a solid bottom)",
              "default": false
            },
            "position_x": {
              "type": "number",
              "title": "Position X",
              "description": "Corner of the baseplate",
              "default": 0,
              "unit": "mm"
            },
            "position_y": {
              "type": "number",
              "title": "Position Y",
              "description": "Corner of the baseplate",
              "default": 0,
              "unit": "mm"
            },
            "title": {
              "type": "string",
              "title": "Body name",
              "description": "Leave empty for an automatic name",
              "maxLength": 60
            },
            "grid": {
              "type": "string",
              "title": "Grid size",
              "description": "Full: 42 mm pockets. Half: 21 mm pockets. Custom: your own cell size, set below (fits only other parts with the same size)",
              "enum": [
                "42 mm (full)",
                "21 mm (half)",
                "Custom (sizes below)"
              ],
              "default": "42 mm (full)"
            },
            "bottom": {
              "type": "string",
              "title": "Bottom",
              "description": "Solid floor, or just the frame (lighter, no magnet holes)",
              "enum": [
                "Solid",
                "Open (frame only)"
              ],
              "default": "Solid"
            },
            "custom_size_x": {
              "type": "number",
              "title": "Custom cell X",
              "description": "Cell size along X, only used when Grid size is Custom",
              "minimum": 15,
              "maximum": 100,
              "default": 42,
              "unit": "mm"
            },
            "custom_size_y": {
              "type": "number",
              "title": "Custom cell Y",
              "description": "Cell size along Y, only used when Grid size is Custom",
              "minimum": 15,
              "maximum": 100,
              "default": 42,
              "unit": "mm"
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Gridfinity baseplate"
          }
        ]
      }
    ],
    "commands": [
      "sketch.create",
      "sketch.rectangle.rounded",
      "sketch.circle.center",
      "sketch.finish",
      "solid.extrude",
      "solid.box"
    ],
    "limits": {
      "fuel": 2000000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    }
  }
}
