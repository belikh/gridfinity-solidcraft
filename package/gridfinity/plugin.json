{
  "id": "gridfinity",
  "name": "Gridfinity",
  "version": "0.1.1",
  "description": "Gridfinity bins (feet, stacking lip, magnet/screw holes, dividers) and baseplates as ordinary editable features.",
  "capabilities": [
    "commands@0.1"
  ],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {
        "name": "bin",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "required": [
            "width",
            "depth",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "title": "Width",
              "description": "Cells along X (42 mm each)",
              "minimum": 1,
              "maximum": 12,
              "default": 1,
              "unit": "cells"
            },
            "depth": {
              "type": "integer",
              "title": "Depth",
              "description": "Cells along Y (42 mm each)",
              "minimum": 1,
              "maximum": 12,
              "default": 1,
              "unit": "cells"
            },
            "height": {
              "type": "integer",
              "title": "Height",
              "description": "Height units (7 mm each)",
              "minimum": 2,
              "maximum": 20,
              "default": 3,
              "unit": "units"
            },
            "magnets": {
              "type": "boolean",
              "title": "Magnet holes",
              "description": "6.5 x 2.4 mm holes in every foot",
              "default": false
            },
            "screws": {
              "type": "boolean",
              "title": "Screw holes",
              "description": "3 mm holes in every foot",
              "default": false
            },
            "dividers_x": {
              "type": "integer",
              "title": "Dividers across X",
              "description": "Walls splitting the bin along X",
              "minimum": 0,
              "maximum": 10,
              "default": 0
            },
            "dividers_y": {
              "type": "integer",
              "title": "Dividers across Y",
              "description": "Walls splitting the bin along Y",
              "minimum": 0,
              "maximum": 10,
              "default": 0
            },
            "stacking_lip": {
              "type": "boolean",
              "title": "Stacking lip",
              "description": "Lip on top so bins stack",
              "default": true
            },
            "origin_x": {
              "type": "number",
              "title": "Position X",
              "description": "Corner of the bin",
              "default": 0,
              "unit": "mm"
            },
            "origin_y": {
              "type": "number",
              "title": "Position Y",
              "description": "Corner of the bin",
              "default": 0,
              "unit": "mm"
            },
            "name": {
              "type": "string",
              "title": "Body name",
              "description": "Leave empty for an automatic name",
              "maxLength": 60
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Gridfinity bin"
          }
        ]
      },
      {
        "name": "baseplate",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "required": [
            "width",
            "depth"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "title": "Width",
              "description": "Cells along X (42 mm each)",
              "minimum": 1,
              "maximum": 12,
              "default": 3,
              "unit": "cells"
            },
            "depth": {
              "type": "integer",
              "title": "Depth",
              "description": "Cells along Y (42 mm each)",
              "minimum": 1,
              "maximum": 12,
              "default": 3,
              "unit": "cells"
            },
            "magnets": {
              "type": "boolean",
              "title": "Magnet holes",
              "description": "6.5 x 2.4 mm holes in every pocket",
              "default": false
            },
            "origin_x": {
              "type": "number",
              "title": "Position X",
              "description": "Corner of the baseplate",
              "default": 0,
              "unit": "mm"
            },
            "origin_y": {
              "type": "number",
              "title": "Position Y",
              "description": "Corner of the baseplate",
              "default": 0,
              "unit": "mm"
            },
            "name": {
              "type": "string",
              "title": "Body name",
              "description": "Leave empty for an automatic name",
              "maxLength": 60
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Gridfinity baseplate"
          }
        ]
      }
    ],
    "commands": [
      "sketch.create",
      "sketch.rectangle.rounded",
      "sketch.circle.center",
      "sketch.finish",
      "solid.extrude",
      "solid.box"
    ],
    "limits": {
      "fuel": 2000000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    }
  }
}
